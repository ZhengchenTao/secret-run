#!/bin/sh
# secret -- Git Bash / POSIX shim for secret.ps1 (prefers pwsh, falls back to Windows PowerShell 5.1).
# Git Bash would rewrite /-looking arguments (store paths, ~/.ssh/... targets) into Windows paths: turn that off.
export MSYS_NO_PATHCONV=1
export MSYS2_ARG_CONV_EXCL='*'
here=$(cd "$(dirname "$0")" && pwd)
cli="$here/secret.ps1"
if command -v cygpath >/dev/null 2>&1; then cli=$(cygpath -w "$cli"); fi
# pwsh only if it actually starts: the Store build's execution alias is "Permission denied" inside sshd sessions
# (seen on Windows 11), while powershell.exe 5.1 always works.
if command -v pwsh >/dev/null 2>&1 && pwsh -NoProfile -NonInteractive -Command 'exit 0' >/dev/null 2>&1; then ps=pwsh
elif command -v powershell.exe >/dev/null 2>&1; then ps=powershell.exe
else echo "secret: neither pwsh nor powershell.exe found" >&2; exit 1; fi
exec "$ps" -NoProfile -ExecutionPolicy Bypass -File "$cli" "$@"
