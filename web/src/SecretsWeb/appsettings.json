{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PublicOrigin": "",
  "Deployment": {
    "AccessLayer": ""
  },
  "Network": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Auth": {
    "Authority": "",
    "ClientId": "secrets-web",
    "ClientSecret": "",
    "CallbackPath": "/signin-oidc",
    "Scopes": [ "openid", "email", "profile" ],
    "Resource": "",
    "AllowedSubjects": [],
    "AllowedEmails": [],
    "RequireAmr": "",
    "IdleTimeoutMinutes": 15,
    "MaxLifetimeHours": 8
  },
  "Repo": {
    "GitDir": "/repo",
    "Identity": "/identity/identity.txt",
    "GitPath": "git",
    "AgePath": "age",
    "CommandTimeoutSeconds": 30,
    "FileTextMaxBytes": 262144,
    "FileMaxBytes": 1048576,
    "DocMaxBytes": 1048576
  },
  "Audit": {
    "Path": "/data/audit.log",
    "MaxBytes": 8388608,
    "KeepFiles": 5
  },
  "DecryptLimits": {
    "PerMinute": 20,
    "PerHour": 200,
    "DistinctWindowMinutes": 10,
    "DistinctThreshold": 30
  },
  "Alerts": {
    "WebhookUrl": "",
    "WebhookToken": "",
    "MinIntervalMinutes": 10
  }
}
